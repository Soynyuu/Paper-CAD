# Backend Local Demo Environment Configuration

ENV=local_demo
PORT=8001
FRONTEND_URL=http://localhost:8080
CORS_ALLOW_ALL=false

# Local demo cache. Generated by:
#   python scripts/prepare_local_demo_cache.py --validate
LOCAL_DEMO_CACHE_DIR=data/local_demo_cache
LOCAL_DEMO_MANIFEST_PATH=data/local_demo_cache/manifest.json
LOCAL_DEMO_PUBLIC_BASE_URL=http://localhost:8001/local-demo-cache

# CityGML cache used by local_demo. If unset, backend defaults to
# ${LOCAL_DEMO_CACHE_DIR}/citygml_cache.
CITYGML_CACHE_ENABLED=true
CITYGML_CACHE_DIR=data/local_demo_cache/citygml_cache

# Keep local demo deterministic and offline after preparation.
WORKERS=2
